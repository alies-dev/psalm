{
    "schema": 1,
    "php": "8.5",
    "memory_limit": "12G",
    "shards": {
        "cg-1": {
            "mode": "cachegrind",
            "tier": "pr"
        },
        "cg-2": {
            "mode": "cachegrind",
            "tier": "pr"
        },
        "cg-3": {
            "mode": "cachegrind",
            "tier": "pr"
        },
        "cg-4": {
            "mode": "cachegrind",
            "tier": "pr"
        },
        "cg-5": {
            "mode": "cachegrind",
            "tier": "pr"
        },
        "nat-laravel": {
            "mode": "native",
            "tier": "pr"
        },
        "nat-symfony": {
            "mode": "native",
            "tier": "pr"
        },
        "nat-drupal": {
            "mode": "native",
            "tier": "pr"
        },
        "nat-wordpress": {
            "mode": "native",
            "tier": "pr"
        }
    },
    "projects": {
        "doctrine-orm": {
            "repo": "https://github.com/doctrine/orm",
            "ref": "4487f850401c0e1f27891cce5897fa90b3055c2a",
            "tag": "3.7.6",
            "shards": [
                "cg-1"
            ],
            "timeout": 1500,
            "exercises": "deep class hierarchies, class-string<T> repositories, attributes metadata"
        },
        "psl": {
            "repo": "https://github.com/php-standard-library/php-standard-library",
            "ref": "f537759b58ba36c8093505004e1bff7578238736",
            "tag": "6.4.2",
            "shards": [
                "cg-2"
            ],
            "timeout": 3000,
            "exercises": "heavily templated functional library, 70+ packages, generics, conditional types, assertions"
        },
        "phpunit": {
            "repo": "https://github.com/sebastianbergmann/phpunit",
            "ref": "941457a4f147a60fe2074d40e1fce0d08ea8d930",
            "tag": "13.4.5",
            "shards": [
                "cg-3"
            ],
            "timeout": 1200,
            "exercises": "large final-class codebase, readonly/immutable value objects, modern PHP 8.4 syntax, event system"
        },
        "php-parser": {
            "repo": "https://github.com/nikic/PHP-Parser",
            "ref": "9e33da9553fe7786f0962b35f4e4ecf01be89def",
            "tag": "v5.9.0",
            "shards": [
                "cg-4"
            ],
            "timeout": 1200,
            "exercises": "large AST node class hierarchy, many untyped closures and arrays, visitor pattern"
        },
        "amphp-amp": {
            "repo": "https://github.com/amphp/amp",
            "ref": "73c38b323ff8d790abf0f76c56fcc892bda4111a",
            "tag": "v3.1.3",
            "shards": [
                "cg-5"
            ],
            "timeout": 900,
            "exercises": "fibers, generics (Future<T>), closures templates, small and fast"
        },
        "webmozarts-assert": {
            "repo": "https://github.com/webmozarts/assert",
            "ref": "8a163706bbcac613733dba03f51e13b5eb1bb819",
            "tag": "2.5.0",
            "shards": [
                "cg-5"
            ],
            "timeout": 900,
            "exercises": "psalm-assert type narrowing, pure/immutable annotations, static-analysis fixture files"
        },
        "laravel": {
            "repo": "https://github.com/laravel/framework",
            "ref": "d52c3b3129e4c8e213c97cdc68f94b0b7d27f181",
            "tag": "v13.39.0",
            "shards": [
                "nat-laravel"
            ],
            "timeout": 600,
            "exercises": "magic __call/macros, Eloquent generics and template inference, large Collection/Support type surface, facades, container resolution"
        },
        "symfony": {
            "repo": "https://github.com/symfony/symfony",
            "ref": "34a08ab1b25dac1ebbdca78927f27cf353993625",
            "tag": "v8.1.10",
            "shards": [
                "nat-symfony"
            ],
            "timeout": 900,
            "exercises": "very wide codebase (about 4400 files), PHP 8.4+ features (property hooks, asymmetric visibility), many small independent components, polyfills, heavy interface graphs"
        },
        "drupal": {
            "repo": "https://github.com/drupal/drupal",
            "ref": "76deda03b09b57d76941e2d30e6dade35e92a14a",
            "tag": "11.4.11",
            "shards": [
                "nat-drupal"
            ],
            "timeout": 900,
            "exercises": "custom file extensions (.module/.inc/.install), procedural hooks plus OOP services, plugin/annotation/attribute discovery, dynamic entity APIs, large taint graph"
        },
        "wordpress": {
            "repo": "https://github.com/WordPress/wordpress-develop",
            "ref": "0afb74de8c3fe4c1869e44b62b0418d67b11aa4c",
            "tag": "7.1.4",
            "shards": [
                "nat-wordpress"
            ],
            "timeout": 900,
            "composer": false,
            "setup": "mkdir -p vendor && echo '<?php' > vendor/autoload.php",
            "exercises": "procedural global-function code (allFunctionsGlobal), global state and superglobals, no autoloader, extraFiles for vendored libraries, huge taint surface"
        }
    }
}
