{
    "schema": 2,
    "branches": [
        "master"
    ],
    "php": "8.5",
    "memory_limit": {
        "cachegrind": "10G",
        "native": "12G"
    },
    "pr_budget_seconds": 360,
    "install_timeout": 180,
    "measured_cpus": [
        "AMD EPYC 7763 64-Core Processor",
        "AMD EPYC 9V74 80-Core Processor",
        "AMD EPYC 9V45 96-Core Processor",
        "INTEL(R) XEON(R) PLATINUM 8573C",
        "Intel(R) Xeon(R) 6973P-C",
        "Intel(R) Xeon(R) 6975P-C",
        "Intel(R) Xeon(R) Platinum 8370C CPU @ 2.80GHz"
    ],
    "shards": {
        "cg-orm": {
            "mode": "cachegrind",
            "tier": "pr"
        },
        "cg-psl": {
            "mode": "cachegrind",
            "tier": "pr"
        },
        "cg-phpunit": {
            "mode": "cachegrind",
            "tier": "pr"
        },
        "cg-parser": {
            "mode": "cachegrind",
            "tier": "pr"
        },
        "cg-small": {
            "mode": "cachegrind",
            "tier": "pr"
        },
        "nat-laravel": {
            "mode": "native",
            "tier": "pr"
        },
        "nat-symfony": {
            "mode": "native",
            "tier": "pr"
        },
        "nat-drupal": {
            "mode": "native",
            "tier": "pr"
        },
        "post-cg-orm": {
            "mode": "cachegrind",
            "tier": "post-merge"
        },
        "post-cg-psl": {
            "mode": "cachegrind",
            "tier": "post-merge"
        },
        "post-cg-phpunit": {
            "mode": "cachegrind",
            "tier": "post-merge"
        },
        "post-cg-parser": {
            "mode": "cachegrind",
            "tier": "post-merge"
        },
        "nat-wordpress": {
            "mode": "native",
            "tier": "post-merge"
        }
    },
    "projects": {
        "orm-slice": {
            "repo": "https://github.com/doctrine/orm",
            "ref": "4487f850401c0e1f27891cce5897fa90b3055c2a",
            "tag": "3.7.6",
            "config": "orm-slice",
            "lock": "doctrine-orm",
            "shards": [
                "cg-orm"
            ],
            "expected_seconds": 254,
            "expected_ir": 41398987166,
            "expected_install_seconds": 6,
            "expected_mb": 253,
            "exercises": "slice of doctrine-orm: core src/ (UnitOfWork, EntityManager, QueryBuilder, persisters, repositories, proxies) without src/Query, src/Mapping, src/Tools, src/Cache; deep class hierarchies, class-string<T> repositories, attributes metadata"
        },
        "psl-slice": {
            "repo": "https://github.com/php-standard-library/php-standard-library",
            "ref": "f537759b58ba36c8093505004e1bff7578238736",
            "tag": "6.4.2",
            "config": "psl-slice",
            "lock": "psl",
            "shards": [
                "cg-psl"
            ],
            "expected_seconds": 260,
            "expected_ir": 42506646278,
            "expected_install_seconds": 6,
            "expected_mb": 317,
            "exercises": "slice of psl: 30 packages (type, collection, dict, vec, iter, str, math, option/result/either, async, io, encoding, filesystem, ...); heavily templated functional library, 70+ packages, generics, conditional types, assertions"
        },
        "phpunit-slice": {
            "repo": "https://github.com/sebastianbergmann/phpunit",
            "ref": "941457a4f147a60fe2074d40e1fce0d08ea8d930",
            "tag": "13.4.5",
            "config": "phpunit-slice",
            "lock": "phpunit",
            "shards": [
                "cg-phpunit"
            ],
            "expected_seconds": 257,
            "expected_ir": 41986892104,
            "expected_install_seconds": 15,
            "expected_mb": 344,
            "exercises": "slice of phpunit: src/Framework and src/Runner; large final-class codebase, readonly/immutable value objects, modern PHP 8.4 syntax, event system"
        },
        "php-parser-slice": {
            "repo": "https://github.com/nikic/PHP-Parser",
            "ref": "9e33da9553fe7786f0962b35f4e4ecf01be89def",
            "tag": "v5.9.0",
            "config": "php-parser-slice",
            "lock": "php-parser",
            "shards": [
                "cg-parser"
            ],
            "expected_seconds": 299,
            "expected_ir": 48864724273,
            "expected_install_seconds": 3,
            "expected_mb": 159,
            "exercises": "slice of php-parser: generated Parser/Php7.php plus Builder, Lexer, NodeVisitor, NodeTraverser, NodeFinder, Internal, ErrorHandler (Php8.php and the other non-parser files are not analysed, only loaded as dependencies); large AST node class hierarchy, many untyped closures and arrays, visitor pattern"
        },
        "amphp-amp": {
            "repo": "https://github.com/amphp/amp",
            "ref": "73c38b323ff8d790abf0f76c56fcc892bda4111a",
            "tag": "v3.1.3",
            "config": "amphp-amp",
            "lock": "amphp-amp",
            "shards": [
                "cg-small"
            ],
            "expected_seconds": 63,
            "expected_ir": 10219919143,
            "expected_install_seconds": 4,
            "expected_mb": 59,
            "exercises": "fibers, generics (Future<T>), closures templates, small and fast"
        },
        "webmozarts-assert": {
            "repo": "https://github.com/webmozarts/assert",
            "ref": "8a163706bbcac613733dba03f51e13b5eb1bb819",
            "tag": "2.5.0",
            "config": "webmozarts-assert",
            "lock": "webmozarts-assert",
            "shards": [
                "cg-small"
            ],
            "expected_seconds": 145,
            "expected_ir": 23680460948,
            "expected_install_seconds": 3,
            "expected_mb": 268,
            "exercises": "psalm-assert type narrowing, pure/immutable annotations, static-analysis fixture files"
        },
        "laravel": {
            "repo": "https://github.com/laravel/framework",
            "ref": "d52c3b3129e4c8e213c97cdc68f94b0b7d27f181",
            "tag": "v13.39.0",
            "config": "laravel",
            "lock": "laravel",
            "shards": [
                "nat-laravel"
            ],
            "expected_seconds": 167,
            "expected_install_seconds": 120,
            "expected_mb": 1905,
            "exercises": "magic __call/macros, Eloquent generics and template inference, large Collection/Support type surface, facades, container resolution"
        },
        "symfony": {
            "repo": "https://github.com/symfony/symfony",
            "ref": "34a08ab1b25dac1ebbdca78927f27cf353993625",
            "tag": "v8.1.10",
            "config": "symfony",
            "lock": "symfony",
            "shards": [
                "nat-symfony"
            ],
            "expected_seconds": 205,
            "expected_install_seconds": 130,
            "install_timeout": 240,
            "expected_mb": 3373,
            "exercises": "very wide codebase (about 4400 files), PHP 8.4+ features (property hooks, asymmetric visibility), many small independent components, polyfills, heavy interface graphs"
        },
        "drupal": {
            "repo": "https://github.com/drupal/drupal",
            "ref": "76deda03b09b57d76941e2d30e6dade35e92a14a",
            "tag": "11.4.11",
            "config": "drupal",
            "lock": "drupal",
            "shards": [
                "nat-drupal"
            ],
            "expected_seconds": 263,
            "expected_install_seconds": 25,
            "expected_mb": 4999,
            "exercises": "custom file extensions (.module/.inc/.install), procedural hooks plus OOP services, plugin/annotation/attribute discovery, dynamic entity APIs, large taint graph"
        },
        "doctrine-orm": {
            "repo": "https://github.com/doctrine/orm",
            "ref": "4487f850401c0e1f27891cce5897fa90b3055c2a",
            "tag": "3.7.6",
            "config": "doctrine-orm",
            "lock": "doctrine-orm",
            "shards": [
                "post-cg-orm"
            ],
            "expected_seconds": 515,
            "expected_ir": 84196135487,
            "expected_install_seconds": 6,
            "expected_mb": 440,
            "exercises": "deep class hierarchies, class-string<T> repositories, attributes metadata"
        },
        "psl": {
            "repo": "https://github.com/php-standard-library/php-standard-library",
            "ref": "f537759b58ba36c8093505004e1bff7578238736",
            "tag": "6.4.2",
            "config": "psl",
            "lock": "psl",
            "shards": [
                "post-cg-psl"
            ],
            "expected_seconds": 694,
            "expected_ir": 113437574321,
            "expected_install_seconds": 6,
            "expected_mb": 664,
            "exercises": "heavily templated functional library, 70+ packages, generics, conditional types, assertions"
        },
        "phpunit": {
            "repo": "https://github.com/sebastianbergmann/phpunit",
            "ref": "941457a4f147a60fe2074d40e1fce0d08ea8d930",
            "tag": "13.4.5",
            "config": "phpunit",
            "lock": "phpunit",
            "shards": [
                "post-cg-phpunit"
            ],
            "expected_seconds": 547,
            "expected_ir": 89395322859,
            "expected_install_seconds": 15,
            "expected_mb": 527,
            "exercises": "large final-class codebase, readonly/immutable value objects, modern PHP 8.4 syntax, event system"
        },
        "php-parser": {
            "repo": "https://github.com/nikic/PHP-Parser",
            "ref": "9e33da9553fe7786f0962b35f4e4ecf01be89def",
            "tag": "v5.9.0",
            "config": "php-parser",
            "lock": "php-parser",
            "shards": [
                "post-cg-parser"
            ],
            "expected_seconds": 580,
            "expected_ir": 94735274255,
            "expected_install_seconds": 3,
            "expected_mb": 218,
            "exercises": "large AST node class hierarchy, many untyped closures and arrays, visitor pattern"
        },
        "wordpress": {
            "repo": "https://github.com/WordPress/wordpress-develop",
            "ref": "0afb74de8c3fe4c1869e44b62b0418d67b11aa4c",
            "tag": "7.1.4",
            "config": "wordpress",
            "shards": [
                "nat-wordpress"
            ],
            "expected_seconds": 336,
            "expected_install_seconds": 200,
            "install_timeout": 300,
            "expected_mb": 11762,
            "exercises": "procedural global-function code (allFunctionsGlobal), global state and superglobals, no autoloader, extraFiles for vendored libraries, huge taint surface",
            "composer": false,
            "setup": "mkdir -p vendor && echo '<?php' > vendor/autoload.php",
            "disabled": "master peaks at 11.7 GiB (taint bug); re-enable after vimeo/psalm#12618/#12561 with re-measured expected_mb"
        }
    }
}
