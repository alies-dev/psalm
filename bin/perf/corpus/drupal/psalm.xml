<?xml version="1.0"?>
<psalm
    errorLevel="4"
    resolveFromConfigFile="true"
    findUnusedCode="false"
    findUnusedBaselineEntry="false"
    findUnusedIssueHandlerSuppression="false"
    xmlns="https://getpsalm.org/schema/config"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="core/lib" />
        <directory name="core/modules" />
        <ignoreFiles allowMissingFiles="true">
            <directory name="core/modules/*/tests" />
            <directory name="core/modules/*/src/Tests" />
            <directory name="core/lib/Drupal/Component/*/Tests" />
        </ignoreFiles>
    </projectFiles>
    <fileExtensions>
        <extension name=".php" />
        <extension name=".module" />
        <extension name=".inc" />
        <extension name=".install" />
        <extension name=".theme" />
        <extension name=".profile" />
        <extension name=".engine" />
    </fileExtensions>
</psalm>
