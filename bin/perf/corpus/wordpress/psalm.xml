    </projectFiles>
    <extraFiles>
        <directory name="src/wp-includes/ID3" />
        <directory name="src/wp-includes/SimplePie" />
        <directory name="src/wp-includes/Requests" />
        <directory name="src/wp-includes/sodium_compat" />
